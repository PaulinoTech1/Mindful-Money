# Copy to /etc/vault/vault.env, replace every placeholder, then chmod 0600.
VAULT_ENV=production
VAULT_AUTH_POLICY=required
VAULT_ORIGIN=https://vault.example.com
VAULT_RP_ID=vault.example.com
VAULT_RP_NAME=Vault
VAULT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# vault_app role, same-host Unix socket -- see deploy/DEPLOYMENT.md §3.
VAULT_DATABASE_URL=postgresql+psycopg://vault_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@/vault_prod?host=/var/run/postgresql
VAULT_TRUST_PROXY=1
VAULT_CSP_MODE=enforce
