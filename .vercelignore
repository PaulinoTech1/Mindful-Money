# Files excluded from the Vercel deployment payload (repo keeps them).
# Same syntax as .gitignore; evaluated at deploy time.

# Doc screenshots (regenerated by test_browser.py; nothing serves them)
screenshots/

# Test suites: dev/CI only
test_*.py

# Single-node deploy docs (systemd/nginx/gunicorn): not a Vercel target
deploy/
docker-compose.yml

# ZKP circuit sources and build artifacts: dev only.
# The server verifier needs only the pinned verification key + hash.
zkp/*
!zkp/manual_expense
zkp/manual_expense/*
!zkp/manual_expense/target
zkp/manual_expense/target/*
!zkp/manual_expense/target/vk
!zkp/manual_expense/target/vk_hash

# Browser ZK-prover build workspace: dev only (committed client bundle kept)
static/zkp/package.json
static/zkp/package-lock.json
static/zkp/vite.config.js
static/zkp/smoke_prove.mjs

# Local dev/test databases (already gitignored; belt and suspenders)
*.db
*.db-wal
*.db-shm
