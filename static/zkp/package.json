{
  "name": "mindful-money-manual-expense-zkp",
  "private": true,
  "type": "module",
  "description": "Browser-side Noir 1.0.0-beta.26 and Barretenberg 5.1.0 proving for the manual-expense ZK-proof feature.",
  "scripts": {
    "build": "vite build --configLoader runner",
    "smoke": "node smoke_prove.mjs",
    "test:v4": "node v4_client.test.mjs",
    "build:browser": "vite build --configLoader runner -c vite.browser.config.js && node -e \"require('fs').rmSync('build/assets',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aztec/bb.js": "5.1.0",
    "@noir-lang/acvm_js": "1.0.0-beta.26",
    "@noir-lang/noir_js": "1.0.0-beta.26",
    "@noir-lang/noirc_abi": "1.0.0-beta.26"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "vite": "^7.2.0",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
